@baseUrl = http://localhost:3000
@authToken = {{authenticate.response.body.accessToken}}
@refreshToken = {{authenticate.response.body.refreshToken}}

# MESSAGES
### Lists all messages
GET {{baseUrl}}/messages/
?limit=10
&offset=0
Authorization: Bearer {{authToken}}
### List one message
GET {{baseUrl}}/messages/30/
### Create a message
POST {{baseUrl}}/messages/
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "texto": "De Leo para Joana",
    "deId": 14,
    "paraId": 12
}
### Update a message
PATCH {{baseUrl}}/messages/34/
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "texto": "De Leo para Joana",
    "lido": false
}
### Delete a message
DELETE {{baseUrl}}/messages/34/
Authorization: Bearer {{authToken}}



